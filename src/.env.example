# API
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/ytdt-claims-pipeline
BASE_URL=http://localhost:3000
JWT_SECRET=generate-strong-random-string

# Pipeline settings
PIPELINE_TIMEOUT_MINUTES=30
ML_API_ENDPOINT=http://localhost:3001

# Frontend settings
FRONTEND_URL=http://localhost:3002

# BigQuery
BQ_PROJECT_ID=jfp-data-warehouse
BQ_DATASET=youtube
BQ_CORE_ANALYTICS_DATASET=core_analytics_views
BQ_KEY_FILE=./config/service-account-key.json

# Export settings
EXPORT_FOLDER_NAME_FORMAT='MMM d yyyy hh:mm:ss a'
IGNORED_MCID_PATTERNS=??,MC00
GOOGLE_DRIVE_NAME=youtube_exports

# Slack integration
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_CHANNEL="#youtube-data-chat"

# Google OAuth2 App
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret-here
GOOGLE_REDIRECT_URI=https://piranha-select-squirrel.ngrok-free.app/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAINS=
