# API
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/ytdt-pipeline
BASE_URL=http://localhost:3000
JWT_SECRET=generate-strong-random-string    # node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"


# Pipeline settings
PIPELINE_TIMEOUT_MINUTES=30                 # Timeout for pipeline processing in minutes
ML_API_ENDPOINT=http://localhost:3001       # Optional ML API endpoint
SKIP_VPN=true                               # Uncomment for local testing without VPN

# Frontend settings
# FRONTEND_URL is where users land after Google login, and is always an allowed
# return origin. FRONTEND_URL_ALLOWLIST adds others (comma-separated) so the
# console can be run locally or as a preview deploy; anything not listed falls
# back to FRONTEND_URL.
FRONTEND_URL=http://localhost:3002
FRONTEND_URL_ALLOWLIST=                     # e.g. http://localhost:3002,https://preview.vercel.app

# MySQL
MYSQL_HOST=your_host_here
MYSQL_USER=your_user_here
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=jfp_analytics_prod

# VPN
VPN_CONFIG_FILE=./config/vpn/client.ovpn
VPN_AUTH_FILE=./config/vpn/auth.txt

# Export settings
EXPORT_FOLDER_NAME_FORMAT='MMM d yyyy hh:mm:ss a'
IGNORED_MCID_PATTERNS=??,MC00
GOOGLE_DRIVE_NAME=youtube_exports           # Requires valid SA Key in config/service-account-key.json

# Slack integration
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_CHANNEL=#youtube-data-chat

# Google OAuth2 App
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_WORKSPACE_DOMAINS=jesusfilm.org,p2c.com
JWT_SECRET=generate-strong-random-string

# Unprocessed-claims enrichment (migrated from YT-Validator)
YT_API_KEY=your-youtube-data-api-key                        # videos.list availability check; if unset, video_available defaults True
LICENSED_CSV=./data/Licensed.csv                            # asset_id list for `licensed`
ASSETS_MEDIA_CSV=./data/assets_single_media_component.csv   # asset_id -> media_component_id

# Daily claims ingest (YouTube Reporting API) — see docs/claims-reporting-api.md
CLAIMS_INGEST_ENABLED=false                                 # true to schedule the daily run
CLAIMS_INGEST_TIME_UTC=06:00                                # HH:MM UTC
YT_REPORTING_TOKEN_FILE=./config/youtube-reporting-token.json   # authorized-user token, mode 0600
YT_REPORTING_LOGIN_HINT=media@jesusfilm.org                 # content-manager account; named in alerts and the sign-in script
COLLECTOR_WATCH_TIME_UTC=08:45                              # daily check of YT-Validator's collector


# MySQL -> BigQuery mirror (interim). Mirrors youtube_mcn_claims (Airbyte reads the MCN list
# from BigQuery) and youtube_channels (dbt reads include_in_reporting, which gates both plays
# paths). Delete once process-claims.js writes BigQuery directly — see src/jobs/mirrorMysqlToBq.js
CLAIMS_MIRROR_ENABLED=false                                 # true to schedule the daily run
CLAIMS_MIRROR_TIME_UTC=05:30                                # HH:MM UTC — must run BEFORE the Airbyte sync
BQ_PROJECT_ID=jfp-data-warehouse
BQ_DATASET=airbyte                                          # must match the dataset the connector reads
BQ_KEY_FILE=./config/service-account-key.json
