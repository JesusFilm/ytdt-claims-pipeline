{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "non-major dependencies"
    }
  ],
  "schedule": [
    "before 6am on the first day of the month"
  ],
  "prConcurrentLimit": 3
}
